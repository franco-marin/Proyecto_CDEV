config_version=5

[application]

config/name="Animal 3D"
config/description="Ejemplo: un animal que camina hacia donde hagas click derecho."
run/main_scene="res://escenas/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

