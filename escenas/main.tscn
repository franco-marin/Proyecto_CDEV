[node name="Sur" type="CollisionShape3D" parent="Navegacion/Limites"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 40.5)
shape = SubResource("Shape_limite_ns")

[node name="Este" type="CollisionShape3D" parent="Navegacion/Limites"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 40.5, 2, 0)
shape = SubResource("Shape_limite_eo")

[node name="Oeste" type="CollisionShape3D" parent="Navegacion/Limites"]
