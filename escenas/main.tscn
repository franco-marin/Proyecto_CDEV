[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_script"]
[ext_resource type="StandardMaterial3D" path="res://recursos/material_terreno.tres" id="2_mat_terreno"]
[ext_resource type="PackedScene" path="res://escenas/jugador.tscn" id="3_jugador"]
[ext_resource type="PackedScene" path="res://escenas/marcador.tscn" id="4_marcador"]
[ext_resource type="Script" path="res://scripts/menu_pausa.gd" id="5_menu_pausa"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat"]

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

[sub_resource type="Environment" id="Entorno"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.62, 0.72, 0.68, 1)
fog_density = 0.006

[sub_resource type="NavigationMesh" id="NavMesh"]
geometry_parsed_geometry_type = 1
geometry_collision_mask = 3
cell_size = 0.25
agent_radius = 0.75
agent_height = 1.5
agent_max_climb = 0.25
filter_baking_aabb = AABB(-41, -1, -41, 82, 6, 82)

[sub_resource type="PlaneMesh" id="Mesh_terreno"]
material = ExtResource("2_mat_terreno")
size = Vector2(200, 200)

[sub_resource type="BoxShape3D" id="Shape_terreno"]
size = Vector3(200, 1, 200)

[sub_resource type="BoxShape3D" id="Shape_limite_ns"]
size = Vector3(82, 4, 1)

[sub_resource type="BoxShape3D" id="Shape_limite_eo"]
size = Vector3(1, 4, 82)

[sub_resource type="StyleBoxFlat" id="BarraFondo"]
bg_color = Color(0, 0, 0, 0.55)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[sub_resource type="StyleBoxFlat" id="BarraRelleno"]
bg_color = Color(0.35, 0.8, 0.3, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[node name="Main" type="Node3D"]
script = ExtResource("1_script")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Entorno")

[node name="Sol" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, -0.4096, 0.2868, 0, 0.5736, 0.8192, -0.5, -0.7094, 0.4967, 0, 10, 0)
shadow_enabled = true

[node name="Camara" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 13, 11)
current = true
fov = 55.0

[node name="Navegacion" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("NavMesh")

[node name="Terreno" type="StaticBody3D" parent="Navegacion"]
collision_mask = 0

[node name="MeshInstance3D" type="MeshInstance3D" parent="Navegacion/Terreno"]
